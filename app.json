{
  "expo": {
    "name": "Namaz Yolu",
    "slug": "islami-yasam",
    "version": "0.9.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "islamiyasam",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D6463",
    "ios": {
      "bundleIdentifier": "com.skipsonik.islamiyasam",
      "supportsTablet": true
    },
    "android": {
      "package": "com.skipsonik.islamiyasam",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü bulunduğun yere göre hesaplamak için konumun kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3DDC97",
          "sounds": [
            "./assets/sounds/zil.wav",
            "./assets/sounds/can.wav",
            "./assets/sounds/kristal.wav",
            "./assets/sounds/allah.mp3",
            "./assets/sounds/allah2.mp3",
            "./assets/sounds/besmele.mp3",
            "./assets/sounds/besmele2.mp3",
            "./assets/sounds/tekbir.mp3",
            "./assets/sounds/tekbir2.mp3"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D6463",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (arka plan bildirim yenileme): Room veritabanı sınıfları yansıma ile oluşturulur, R8 silmesin\n-keep class * extends androidx.room.RoomDatabase { <init>(...); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }\n-keep class androidx.startup.** { *; }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5704710295015571~4466889771",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-android-tv",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SiradakiVakit",
              "label": "Sıradaki Vakit",
              "description": "Sıradaki namaz vakti ve saati",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/siradaki.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "NamazVakitleri",
              "label": "Namaz Vakitleri",
              "description": "Günün namaz vakitleri, hicri tarih ve şehir",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget/vakitler.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "hatimApi": "https://mix.gen.tr/islamiyasam/hatim/api.php",
      "messagesBase": "https://mix.gen.tr/islamiyasam/mesajlar/"
    }
  }
}
