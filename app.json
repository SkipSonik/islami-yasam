{
  "expo": {
    "name": "İslami Yaşam",
    "slug": "islami-yasam",
    "version": "0.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "islamiyasam",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B3B2E",
    "ios": {
      "bundleIdentifier": "com.skipsonik.islamiyasam",
      "supportsTablet": false
    },
    "android": {
      "package": "com.skipsonik.islamiyasam",
      "versionCode": 14,
      "adaptiveIcon": {
        "backgroundColor": "#0B3B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitlerini ve kıble yönünü bulunduğun yere göre hesaplamak için konumun kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3DDC97",
          "sounds": [
            "./assets/sounds/zil.wav",
            "./assets/sounds/can.wav",
            "./assets/sounds/kristal.wav",
            "./assets/sounds/allah.mp3",
            "./assets/sounds/allah2.mp3",
            "./assets/sounds/besmele.mp3",
            "./assets/sounds/besmele2.mp3",
            "./assets/sounds/tekbir.mp3",
            "./assets/sounds/tekbir2.mp3"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (arka plan bildirim yenileme): Room veritabanı sınıfları yansıma ile oluşturulur, R8 silmesin\n-keep class * extends androidx.room.RoomDatabase { <init>(...); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }\n-keep class androidx.startup.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "hatimApi": "https://mix.gen.tr/islamiyasam/hatim/api.php"
    }
  }
}
